! Users should add all user specific namelist changes below in the form of 
! namelist_var = new_namelist_value 

! CARMA alumina test inputs (see ~/MIT/cesm2_port/ALUMINA_CARMA_PLAN.md)
carma_emis_file     = '/Users/ashajain/MIT/cesm2_port/emissions/alumina_test_events.nc'
! carma_emis_psd_file: per-model default (atm/waccm/emis/alumina_mono_d<D>um_psd.nc)
! particle size sensitivity test: emissions x1000 (882 kg -> 882 t on day 1)
carma_emis_scale    = 1000.0

! h0: daily means (unchanged).
! h1: daily means of per-bin emission tendency (EM, kg/kg/s) and surface
!     losses (DD sedimentation+dry dep, SW wet dep; kg/m2/s).
! h2: end-of-day instantaneous CRALUM mixing ratios for the burden.
! h3: daily means of the alumina radiative effect. rad_diag_1 = climate list with the
!     CRALUM bins (36, or 16 for alumina_d<D>um), rad_diag_2 = without them, so X_d1 - X_d2 is the alumina effect
!     (rad_climate includes alumina when carma_alumina_rad_feedback = .true.).
!     ODV_CRALUMnn is per-bin visible AOD (climate list only).
nhtfrq = -24, -24, -24, -24
mfilt  = 1, 1, 1, 1
! h3 in double precision: the alumina flux differences are below float32 resolution.
ndens  = 2, 2, 2, 1
fincl2 = 'PS', 'CRALUMVM', 'CRALUM01EM', 'CRALUM02EM', 'CRALUM03EM', 'CRALUM04EM', 'CRALUM05EM',
        'CRALUM06EM', 'CRALUM07EM', 'CRALUM08EM', 'CRALUM09EM', 'CRALUM10EM', 'CRALUM11EM',
        'CRALUM12EM', 'CRALUM13EM', 'CRALUM14EM', 'CRALUM15EM', 'CRALUM16EM', 'CRALUM01DD',
        'CRALUM02DD', 'CRALUM03DD', 'CRALUM04DD', 'CRALUM05DD', 'CRALUM06DD', 'CRALUM07DD',
        'CRALUM08DD', 'CRALUM09DD', 'CRALUM10DD', 'CRALUM11DD', 'CRALUM12DD', 'CRALUM13DD',
        'CRALUM14DD', 'CRALUM15DD', 'CRALUM16DD', 'CRALUM01SW', 'CRALUM02SW', 'CRALUM03SW',
        'CRALUM04SW', 'CRALUM05SW', 'CRALUM06SW', 'CRALUM07SW', 'CRALUM08SW', 'CRALUM09SW',
        'CRALUM10SW', 'CRALUM11SW', 'CRALUM12SW', 'CRALUM13SW', 'CRALUM14SW', 'CRALUM15SW',
        'CRALUM16SW'
fincl3 = 'CRALUM01:I', 'CRALUM02:I', 'CRALUM03:I', 'CRALUM04:I', 'CRALUM05:I', 'CRALUM06:I',
        'CRALUM07:I', 'CRALUM08:I', 'CRALUM09:I', 'CRALUM10:I', 'CRALUM11:I', 'CRALUM12:I',
        'CRALUM13:I', 'CRALUM14:I', 'CRALUM15:I', 'CRALUM16:I', 'PS:I'
fincl4 = 'FSNT', 'FSNT_d1', 'FSNT_d2', 'FLNT', 'FLNT_d1', 'FLNT_d2',
        'FSNS', 'FSNS_d1', 'FSNS_d2', 'FLNS', 'FLNS_d1', 'FLNS_d2',
        'FSUTOA', 'FSUTOA_d1', 'FSUTOA_d2', 'FLUT', 'FLUT_d1', 'FLUT_d2',
        'QRS', 'QRS_d1', 'QRS_d2', 'QRL', 'QRL_d1', 'QRL_d2',
        'AEROD_v', 'AODvstrt', 'ODV_CRALUM01', 'ODV_CRALUM02', 'ODV_CRALUM03', 'ODV_CRALUM04',
        'ODV_CRALUM05', 'ODV_CRALUM06', 'ODV_CRALUM07', 'ODV_CRALUM08', 'ODV_CRALUM09', 'ODV_CRALUM10',
        'ODV_CRALUM11', 'ODV_CRALUM12', 'ODV_CRALUM13', 'ODV_CRALUM14', 'ODV_CRALUM15', 'ODV_CRALUM16'
