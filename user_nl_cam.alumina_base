! Users should add all user specific namelist changes below in the form of 
! namelist_var = new_namelist_value 

! CARMA alumina test inputs (see ~/MIT/cesm2_port/ALUMINA_CARMA_PLAN.md)
carma_emis_file     = '/Users/ashajain/MIT/cesm2_port/emissions/alumina_test_events.nc'
carma_emis_psd_file = '/Users/ashajain/MIT/cesm2_port/emissions/alumina_test_psd.nc'

! h0: daily means (unchanged).
! h1: daily means of per-bin emission tendency (EM, kg/kg/s) and surface
!     losses (DD sedimentation+dry dep, SW wet dep; kg/m2/s).
! h2: end-of-day instantaneous CRALUM mixing ratios for the burden.
! h3: daily means of the alumina radiative effect. rad_diag_1 = climate list with
!     CRALUM01-36, rad_diag_2 = without them, so X_d1 - X_d2 is the alumina effect
!     (rad_climate includes alumina when carma_alumina_rad_feedback = .true.).
!     ODV_CRALUMnn is per-bin visible AOD (climate list only).
nhtfrq = -24, -24, -24, -24
mfilt  = 1, 1, 1, 1
! h3 in double precision: the alumina flux differences are below float32 resolution.
ndens  = 2, 2, 2, 1
